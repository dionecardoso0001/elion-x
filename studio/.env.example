# ─── ADVANCED TECH TI · STUDIO ───────────────────────────────────────
# Copie para .env e preencha. O .env NUNCA vai para o git.

PORT=3333
NODE_ENV=development
# Em produção: obrigatório e com https. É a base de todos os links de
# pagamento e de callback — nunca é deduzida do cabeçalho Host.
PUBLIC_BASE_URL=http://localhost:3333
# Só ligue se houver proxy reverso confiável (Nginx, Cloudflare) na frente.
TRUST_PROXY=0
DATA_FILE=./data/orders.json

# Painel /admin.html — gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_TOKEN=

# ─── Pagamento ───────────────────────────────────────────────────────
# pix    = Pix com a SUA chave; você confirma o crédito no painel (padrão recomendado)
# mock   = checkout simulado (desenvolvimento; bloqueado em produção)
# stripe = Stripe Checkout (confirmação automática por webhook)
PAYMENT_PROVIDER=pix
# Prefira chave aleatória ou CNPJ: a chave aparece para todos os clientes.
PIX_KEY=
# Nome do recebedor (até 25 letras) e cidade (até 15), como no seu banco.
PIX_NAME=Advanced Tech TI
PIX_CITY=Sao Paulo
# Pedido sem pagamento nem aviso de pagamento é cancelado após este prazo.
UNPAID_EXPIRY_HOURS=72
STRIPE_SECRET_KEY=
# Webhook no painel Stripe → endpoint: <PUBLIC_BASE_URL>/api/webhooks/stripe
# Eventos: checkout.session.completed, checkout.session.async_payment_succeeded
STRIPE_WEBHOOK_SECRET=

# ─── Arquivos ────────────────────────────────────────────────────────
# Fotos e entregas ficam em <pasta do DATA_FILE>/files. Tamanho máximo por arquivo de entrega:
MAX_DELIVERY_MB=500
# Segredo das URLs de download (opcional; sem ele, os links são renovados a cada reinício).
FILE_SIGNING_SECRET=

# ─── Avisos para você (opcional) ─────────────────────────────────────
# Recebe um POST a cada pedido novo, aviso de Pix e pedido de ajuste
# (ex.: um bot seu que manda mensagem no Telegram/WhatsApp).
NOTIFY_WEBHOOK_URL=

# ─── Automação com bots Grok (opcional; sem URL, a produção é manual) ─
# Segredo HMAC compartilhado com os bots (32+ caracteres).
BOT_SHARED_SECRET=
# Bot padrão e, opcionalmente, bots específicos por tipo de pacote.
GROK_BOT_URL=
GROK_BOT_URL_VIDEO=
GROK_BOT_URL_PHOTO=
# Hosts aceitos nas URLs entregues pelos bots (vazio = qualquer https).
# Recomendado em produção, ex.: cdn.seudominio.com.br,storage.googleapis.com
DELIVERY_ALLOWED_HOSTS=

# ─── Assistente de roteiro (API xAI, opcional) ───────────────────────
# Sem os dois valores, o assistente fica desligado e o site usa um roteiro-modelo.
XAI_API_KEY=
# Use o id de modelo listado no seu console xAI.
XAI_MODEL=
