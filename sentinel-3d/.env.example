# SENTINEL 3D — variáveis de ambiente (o servidor lê do ambiente; exporte antes de `npm start`)
PORT=8730
HOST=127.0.0.1
# demo | integracao
SENTINEL_MODE=demo
# Obrigatório no modo integração (≥ 32 caracteres). Gere: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Nunca versione o valor real.
SENTINEL_INGEST_TOKEN=
# 1 = perfis de demonstração (somente laboratório); 0 = exige IdP corporativo
SENTINEL_DEMO_AUTH=1
