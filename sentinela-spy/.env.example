# Sentinela Spy — copie para .env (que NUNCA vai para o git) e preencha.

# Chave da API da Anthropic. Com ela, o agente roda no MODO SERVIDOR: a chave fica
# aqui e o navegador nunca a vê. Sem ela, cada operador usa a própria chave no aparelho.
# Defina um limite de gasto no Console da Anthropic (Settings → Limits).
ANTHROPIC_API_KEY=

# Token de acesso ao agente. OBRIGATÓRIO se o servidor for exposto além deste
# computador (HOST=0.0.0.0, túnel, VPS): sem ele, quem alcançar a porta gasta o seu crédito.
SPY_TOKEN=

# Porta e interface de rede. Padrão: 4040 em 127.0.0.1 (só este computador).
PORT=4040
HOST=127.0.0.1

# Consultas ao agente por minuto (todas as abas somadas). Padrão: 12.
SPY_LIMITE_MIN=12

# ── Alerta ao responsável (checagem de saúde do motorista) — passo a passo: ALERTAS.md ──
# Token de cada aparelho (≥ 16 caracteres), vírgula entre eles: carro1:abc…,carro2:def…
RELE_TOKENS=
# WhatsApp Cloud API (Meta) — modelo de mensagem APROVADO com 5 variáveis
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=alerta_saude_motorista
WHATSAPP_IDIOMA=pt_BR
WHATSAPP_DESTINOS=
# E-mail: Resend (domínio próprio) OU Gmail API (os três GMAIL_*)
EMAIL_DESTINOS=
EMAIL_REMETENTE=
RESEND_API_KEY=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
